			if playerConnections[player].charConnections then
				for _, conn in pairs(playerConnections[player].charConnections) do
					conn:Disconnect()
				end
			end
			playerConnections[player].charConnections = watchCharacterState(char)
		end
	
		playerConnections[player].charAddedConn = player.CharacterAdded:Connect(onCharAdded)
	
		if player.Character then 
			onCharAdded(player.Character) 
		end
	end
	
	Players.PlayerAdded:Connect(function(player)
		if player ~= LocalPlayer then
			setupPlayer(player)
		end
	end)
	
	Players.PlayerRemoving:Connect(function(player)
		if playerConnections[player] then
			if playerConnections[player].charConnections then
				for _, conn in pairs(playerConnections[player].charConnections) do conn:Disconnect() end
