			table.insert(connections, rootPart:GetPropertyChangedSignal("CanCollide"):Connect(function()
				if hitboxActive and rootPart.CanCollide then
					rootPart.CanCollide = false
				end
			end))
	
			-- Reset properties when the player dies
			table.insert(connections, humanoid.Died:Connect(function()
